{
    "height": 20,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "spacing": 10,

    "layer": "top",
    "position": "top",
    "exclusive": true,

    "modules-left": [
        "hyprland/workspaces",
        "mpris"
    ],
    "modules-center": [
        "clock"
    ],
    "modules-right": [
        "memory",
        "pulseaudio",
	"network",
        "temperature",
        "battery"
    ],

    "hyprland/workspaces": {
        "format": "{name}",
        "on-click": "activate"
    },

    "network": {
        "format-wifi": "NET <span color='#d3c6aa'>{essid}</span>",
        "format-ethernet": "NET <span color='#d3c6aa'>{ipaddr}</span>",
	"format-disconnected": "NET <span color='#d3c6aa'>OFF</span>",
	"on-click": "kitty nmtui"
    },

    "mpris": {
        "format": " {artist} <span color='#d3c6aa'>{title}</span>",
        "max-length": 40
    },

    "memory": {
        "format": "RAM <span color='#d3c6aa'>{used:0.1f}</span>",
        "tooltip": "RAM {used:0.1f}"
    },

    "pulseaudio": {
        "format": "VOL <span color='#d3c6aa'>{volume}</span>",
        "format-muted": "VOL <span color='#d3c6aa'>OFF</span>",
        "format-icons": {
            "default": [""]
        },
        "scroll-step": 1,
        "on-click": "kitty pulsemixer"
    },

    "temperature": {
        "format": "TMP <span color='#d3c6aa'>{temperatureC}</span>",
        "critical-threshold": 80
    },

    "clock": {
        "format": "{:%Y %b %d <span color='#d3c6aa'>%H:%M</span>}",
        "tooltip-format": "{:%Y-%m-%d  %H:%M:%S}"
    },

    "battery": {
        "interval": 60,
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "BAT <span color='#d3c6aa'>{capacity}</span>"
    }
}
